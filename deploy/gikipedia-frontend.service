[Unit]
Description=Gikipedia frontend (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/srv/gikipedia-frontend/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/node /srv/gikipedia-frontend/current/node_modules/next/dist/bin/next start -H 0.0.0.0 -p 3000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
